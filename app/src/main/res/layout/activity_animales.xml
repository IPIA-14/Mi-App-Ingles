<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".controller.Animales">


    <ImageView
        android:onClick="sonarPig"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="right"
        android:layout_margin="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/pig" />
    <ImageView
        android:onClick="sonarHen"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity=""
        android:layout_margin="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/hen" />
    <ImageView
        android:onClick="sonarDuck"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="right"
        android:layout_margin="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/duck" />
    <ImageView
        android:onClick="sonarSheep"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity=""
        android:layout_margin="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/sheep" />
    <ImageView
        android:onClick="sonarDog"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="right"
        android:layout_margin="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/dog" />

</LinearLayout>